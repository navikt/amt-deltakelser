<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="UTF-8"/>
    <meta name="description" content="Innsøking på tiltak"/>
    <meta name="author" content="amt-pdfgen"/>
    <meta name="subject" content="Innsøkingsbrev"/>

    {{#block 'amt/style' }}
    {{/block}}

    <title>Innsøking på tiltak</title>
</head>

<body>
<div id="footer">
    <span class="sidetall">side <span id="pagenumber"></span> av <span id="pagecount"></span></span>
</div>

{{> sections/header}}

<main>
    <section>
        <h1>
            {{deltakerliste.tiltaksnavn}} hos {{deltakerliste.arrangornavn}}
        </h1>

        <p>Du er søkt inn og Nav vurderer søknaden din. Du vil få beskjed om resultatet.</p>

        <p class="margins-1-rem">
            Opplæringen starter {{iso_to_long_date deltakerliste.startdato}},
            og slutter {{iso_to_long_date deltakerliste.sluttdato}}.
        </p>
    </section>

    <section>
        {{> sections/enkeltplass-innhold}}
    </section>

    {{> sections/enkeltplass-deltakelsesmengde}}

    {{> sections/enkeltplass-pris-og-betalingsbetingelser}}

    {{> sections/sporsmal}}

    {{> sections/avsender}}
</main>
</body>
</html>
