<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="UTF-8"/>
    <meta name="description" content="Vedtak om tiltak"/>
    <meta name="author" content="amt-pdfgen"/>
    <meta name="subject" content="Vedtak"/>

    {{#block 'amt/style' }}
    {{/block}}

    <title>Vedtak om tiltaksdeltakelse</title>
</head>

<body>
<div id="footer">
    <span class="sidetall">side <span id="pagenumber"></span> av <span id="pagecount"></span></span>
</div>

{{> sections/header}}

<main>
    <section>
        <h1>
            {{deltakerliste.tiltaksnavn}} hos {{deltakerliste.arrangornavn}}
        </h1>

        <p>Du har fått godkjent opplæringen.</p>

        <p class="margins-1-rem">
            Nav mener at denne opplæringen vil gi deg bedre muligheter til å komme i arbeid. Opplæringen kan ha
            egne opptakskrav. I så fall er det opplæringsstedet som avgjør om du får plass.
        </p>

        <p class="margins-1-rem">
            Opplæringen starter {{iso_to_long_date deltakerliste.startdato}},
            og slutter {{iso_to_long_date deltakerliste.sluttdato}}.
        </p>
    </section>

    {{> sections/enkeltplass-innhold}}

    {{> sections/enkeltplass-deltakelsesmengde}}

    {{> sections/enkeltplass-pris-og-betalingsbetingelser}}

    {{> sections/dette-er-et-vedtak}}

    {{> sections/rett-til-klage}}

    {{> sections/sporsmal}}

    {{> sections/avsender}}
</main>
</body>
</html>
