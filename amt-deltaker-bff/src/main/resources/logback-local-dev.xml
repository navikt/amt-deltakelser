<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="5 seconds">
    <statusListener class="ch.qos.logback.core.status.OnConsoleStatusListener"/>

    <appender name="consolePlain" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n%ex</pattern>
        </encoder>
    </appender>

    <root level="${ROOT_LOG_LEVEL:-INFO}">
        <appender-ref ref="consolePlain"/>
    </root>

    <!-- Keep noisy libraries under control in local runs -->
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="ch.qos.logback" level="WARN"/>
    <logger name="com.zaxxer.hikari.pool" level="INFO"/>

    <logger name="no.nav" level="DEBUG"/>

</configuration>

