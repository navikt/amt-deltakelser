<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="5 seconds">

    <appender name="consolePlain" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n%ex</pattern>
        </encoder>
    </appender>

    <root level="${ROOT_LOG_LEVEL:-DEBUG}">
        <appender-ref ref="consolePlain"/>
    </root>

    <logger name="org.apache.kafka" level="WARN" />
    <logger name="io.netty" level="WARN" />
    <logger name="com.zaxxer.hikari" level="WARN" />
    <logger name="no.nav.amt" level="DEBUG"/>

    <logger name="no.nav.amt.lib.kafka" level="WARN"/>
    <logger name="no.nav.amt.deltaker.bff.job.LeaderElection" level="WARN"/>

</configuration>

